---
import { Picture } from 'astro:assets';
import Slide from '../Slide.astro';
import type { SiteContent } from '../../content/types';
import salon from '../../assets/salon-okno.webp';

interface Props { content: SiteContent }
const { content } = Astro.props;
---
<Slide id="obiekt" variant="mist" waveFrom="navy" class="about">
  <div class="about__grid">
    <div>
      <h2 id="obiekt-title">{content.about.h2}</h2>
      <p class="about__lead">{content.about.lead}</p>
      <p class="about__body">{content.about.body}</p>
      <dl class="about__stats">
        {content.about.stats.map((s) => (
          <div class="stat">
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <Picture
      src={salon}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(max-width: 60rem) 100vw, 44vw"
      alt={content.alts.salon}
      loading="lazy"
      class="about__photo"
    />
  </div>
</Slide>

<style>
  .about__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 60rem) { .about__grid { grid-template-columns: 1fr 1fr; } }
  h2 { font-size: var(--step-4); }
  .about__lead { margin-top: var(--space-2); font-size: var(--step-1); }
  .about__body { margin-top: var(--space-2); max-width: 46ch; }
  .about__stats { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-4) 0 0; }
  .stat { display: flex; flex-direction: column-reverse; }
  .stat__value { margin: 0; font-size: var(--step-3); font-weight: 200; line-height: 1; }
  .stat__label { font-size: 0.78rem; letter-spacing: .12em; text-transform: uppercase; opacity: .8; margin-top: .35rem; }
  /* Source photo is a tall portrait crop (1868x4000). Left unconstrained,
     `height: auto` renders it at its native ratio and blows the slide's
     height to several viewports, which breaks scroll-snap anchor navigation
     (the dot for this slide lands mostly past the fold). Crop to a sane
     ratio instead, same treatment the gallery thumbnails already use.
     Note: previously this was `.about :global(.about__photo)`, which
     Astro compiles to `.about[data-astro-cid-xxx] .about__photo` — but
     the ancestor `.about` section is rendered by Slide.astro, so it never
     carries About.astro's scope attribute and the rule never matched
     anything. The plain scoped selector below works because Astro forwards
     this file's scope attribute onto Picture's rendered <img> directly. */
  /* `height: auto` must be explicit: the HTML width/height attributes
     Picture emits (mapped from the source's raw 1868x4000 pixels) act as
     a low-priority presentational style, and without an explicit `height`
     declaration here that "height: 4000px" hint wins over aspect-ratio's
     auto-sizing, since aspect-ratio only substitutes for an auto height. */
  .about__photo { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 2px; }
</style>
