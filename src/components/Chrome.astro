---
import Logo from './Logo.astro';
import { FACTS } from '../content/facts';
import type { SiteContent, Lang } from '../content/types';

interface Props { content: SiteContent }
const { content } = Astro.props;
const PATHS: Record<Lang, string> = { pl: '/', de: '/de/', en: '/en/' };
const HREF_LANGS: Record<Lang, string> = { pl: 'pl-PL', de: 'de-DE', en: 'en-GB' };
const ALL_LANGS: Lang[] = ['pl', 'de', 'en'];
---
<header class="chrome">
  <a class="chrome__logo" href={PATHS[content.lang]} aria-label={FACTS.name}>
    <Logo />
  </a>

  <nav class="chrome__lang" aria-label={content.chrome.langLabel}>
    {ALL_LANGS.map((l) => (
      <a
        href={PATHS[l]}
        hreflang={HREF_LANGS[l]}
        lang={HREF_LANGS[l]}
        aria-current={l === content.lang ? 'true' : undefined}
        class={l === content.lang ? 'chrome__lang-current' : undefined}
      >
        <span class="visually-hidden">{content.chrome.langNames[l]}</span>
        <span aria-hidden="true">{l.toUpperCase()}</span>
      </a>
    ))}
  </nav>

  <a class="chrome__call" href={FACTS.phoneHref}>
    <span class="visually-hidden">{content.chrome.callLabel}: </span>
    {FACTS.phoneDisplay}
  </a>
</header>

<style>
  .chrome {
    position: fixed; inset: 0 0 auto 0; z-index: 20;
    display: flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2) clamp(1.25rem, 6vw, 6rem);
    color: var(--white);
    pointer-events: none;
  }
  .chrome > * { pointer-events: auto; }
  /* Scrim jest TRWAŁY, nie tylko awaryjny dla braku JS. Falka dekoracyjna
     (WaveMark) na górze niektórych slajdów bywa jasna, mimo że reszta slajdu
     jest ciemna (i odwrotnie: bywa granatowa na jasnym slajdzie
     obiekt/okolica) — biały albo granatowy znak/przyciski nagłówka nad tą
     falką ginęły. ::before rozciąga się POD dolną krawędź nagłówka, więc
     gradient + maska dają miękkie przejście, bez twardej krechy na granicy
     paska. Świadomy kompromis: axe nie potrafi wyliczyć koloru tła zza
     pseudoelementu, więc zgłasza tu "incomplete" na kontraście — przyjęte,
     bo wygląd (rozmyta, przezroczysta warstwa) jest tu ważniejszy niż to,
     żeby ten jeden test axe przechodził (patrz `.exclude('.chrome')`
     w tests/a11y.spec.js). Realny, mierzony pikselowo kontrast napisu na
     jasnych slajdach nadal pilnuje osobny test niżej w tym samym pliku.
     backdrop-filter jest wyłączony na czas lotu logo z intra
     (html.intro-active) — jest drogi w renderowaniu na każdą klatkę i bez
     tego rozjeżdżał moment lądowania logo; header jest wtedy i tak schowany
     pod nieprzezroczystą nakładką intra, więc nic nie widać. */
  .chrome::before {
    content: ''; position: absolute; inset: 0 0 -6rem 0; z-index: -1;
    background: linear-gradient(to bottom, rgba(2,64,118,.78), rgba(2,64,118,.4) 55%, transparent);
    backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(to bottom, black, black 50%, transparent);
    mask-image: linear-gradient(to bottom, black, black 50%, transparent);
  }
  :global(html.intro-active) .chrome::before { backdrop-filter: none; }
  .chrome[data-on-light]::before {
    background: linear-gradient(to bottom, rgba(255,255,255,.85), rgba(255,255,255,.45) 55%, transparent);
  }
  .chrome__logo { width: clamp(74px, 8vw, 108px); margin-inline-end: auto; }
  .chrome__lang { display: flex; gap: 0.15rem; font-size: 0.82rem; font-weight: 600; }
  .chrome__lang a, .chrome__lang-current {
    display: grid; place-items: center; min-width: 2.25rem; min-height: 2.25rem;
    border-radius: var(--radius-pill); text-decoration: none;
  }
  .chrome__lang-current { background: rgba(255,255,255,0.22); }
  .chrome__lang a:hover { background: rgba(255,255,255,0.12); }
  .chrome__call {
    border: 1px solid rgba(255,255,255,0.75); border-radius: var(--radius-pill);
    padding: 0.6rem 1.15rem; font-weight: 600; text-decoration: none; white-space: nowrap;
  }
  .chrome__call:hover { background: var(--white); color: var(--navy); }

  /* Numer telefonu w nagłówku dubluje się z przyciskiem CTA na hero i
     numerem na slajdzie kontaktu — na wąskim ekranie w rzędzie nagłówka
     (logo + PL/DE/EN + numer) i tak by się nie zmieścił bez zawijania, więc
     zamiast poprzedniego przyklejonego paska u dołu ekranu po prostu go tu
     chowamy; wywołanie telefonu zostaje dostępne przez te dwa pozostałe
     miejsca. */
  @media (max-width: 40rem) {
    .chrome__call { display: none; }
  }

  /* Jedno miejsce, w którym stała warstwa zmienia kolor na jasnych slajdach.
     Logo dziedziczy `color` stąd (patrz Logo.astro) — nie ma osobnej reguły
     na .logo, więc nie ma czego pominąć przy zmianie. */
  .chrome[data-on-light] { color: var(--navy); }
  .chrome[data-on-light] .chrome__call { border-color: rgba(4,71,122,.5); }
  .chrome[data-on-light] .chrome__call:hover { background: var(--navy); color: var(--white); }
  .chrome[data-on-light] .chrome__lang-current { background: rgba(4,71,122,.12); }
  .chrome[data-on-light] .chrome__lang a:hover { background: rgba(4,71,122,.08); }
</style>

<script>
  const chrome = document.querySelector('.chrome');
  const LIGHT = new Set(['obiekt', 'okolica']);
  if (chrome) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          chrome.toggleAttribute('data-on-light', LIGHT.has(e.target.id));
        }
      },
      { threshold: 0.55 }
    );
    for (const s of document.querySelectorAll('main section')) io.observe(s);
  }
</script>
