---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import Slide from '../../components/Slide.astro';
import SlideNav from '../../components/SlideNav.astro';
import Hero from '../../components/slides/Hero.astro';
import About from '../../components/slides/About.astro';
import Apartment from '../../components/slides/Apartment.astro';
import Area from '../../components/slides/Area.astro';
import { de as c } from '../../content/de';

const IDS = ['start', 'obiekt', 'apartament', 'okolica', 'kontakt'];
---
<Base content={c}>
  <Chrome content={c} />
  <SlideNav ids={IDS} names={c.chrome.slideNames} label={c.chrome.navLabel} />
  <main id="tresc" class="slides">
    <Hero content={c} />
    <About content={c} />
    <Apartment content={c} />
    <Area content={c} />
    <Slide id="kontakt" variant="navy" waveFrom="white"><h2 id="kontakt-title">{c.contact.h2}</h2></Slide>
  </main>
</Base>
